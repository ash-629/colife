# Copy to .env for local configuration.
LLM_PROVIDER=deepseek
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_API_KEY=

# Application request policy.
LLM_REQUEST_TIMEOUT_MS=60000
LLM_MAX_RETRIES=2

# Optional exact public origins for temporary sharing, comma-separated.
PUBLIC_ORIGINS=
