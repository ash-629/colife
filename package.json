{
  "name": "colife",
  "version": "1.0.0",
  "private": true,
  "description": "同频 CoLife 个人学习与生活管理平台",
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch apps/api/server.ts",
    "dev:web": "vite",
    "start": "tsx apps/api/server.ts",
    "prototype": "node prototype/server.cjs",
    "check": "tsc --noEmit",
    "build": "vite build",
    "test": "tsx --test tests/*.test.ts",
    "verify": "npm run check && npm test && npm run build",
    "format": "prettier --write apps shared tests scripts vite.config.ts tsconfig.json package.json",
    "backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/restore.ts",
    "migrate": "tsx scripts/migrate.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "model:check": "tsx scripts/model-check.ts",
    "acceptance:check": "tsx scripts/acceptance-check.ts",
    "security:check": "tsx scripts/check-secrets.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.5",
    "dotenv": "^18.0.6",
    "fastify": "^5.12.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.5",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.3"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "shell-quote": "^1.11.0"
  }
}
